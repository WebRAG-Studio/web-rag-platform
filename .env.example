# Runtime storage (never commit its contents)
DATA_DIR=data/sites
SITE_NAME=
WEBSITE_URL=
LOG_LEVEL=INFO

# auto tries Gemini, then Ollama, then safe local fallback
GENERATION_PROVIDER=auto
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1:8b
REQUEST_TIMEOUT=30

# Offline-safe default. Set true only after installing sentence-transformers.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RERANKER_MODEL=
ENABLE_LOCAL_EMBEDDINGS=false
ENABLE_OCR=true
MAX_PAGES=100
MAX_DOCUMENT_MB=25
